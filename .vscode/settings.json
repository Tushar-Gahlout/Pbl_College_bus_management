{
    "cmake.sourceDirectory": "${workspaceFolder}/CollegeBusManagement",
    "cmake.buildDirectory": "${workspaceFolder}/CollegeBusManagement/build",
    "cmake.configureSettings": {
        "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/qt@6;/opt/homebrew/opt/qt"
    },
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/CollegeBusManagement/**",
        "/opt/homebrew/opt/qt@6/include/**",
        "/opt/homebrew/opt/qt/include/**"
    ],
    "files.associations": {
        "*.h": "cpp",
        "*.cpp": "cpp",
        "*.qss": "css"
    }
}
