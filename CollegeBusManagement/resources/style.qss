/* ===================================================================
 * College Bus Management System - Modern Deep Indigo & Royal Slate Theme
 * =================================================================== */

/* Global Settings */
QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
    color: #1e1b4b;
    background-color: #f8fafc;
}

/* Sidebar Styling */
#sidebar {
    background-color: #1e1b4b;
    border-right: 1px solid #312e81;
    min-width: 230px;
    max-width: 230px;
}

#sidebarHeader {
    background-color: #2e1065;
    padding: 16px;
    border-bottom: 1px solid #4338ca;
}

#appTitle {
    color: #a5b4fc;
    font-size: 16px;
    font-weight: 700;
}

#appSubtitle {
    color: #c7d2fe;
    font-size: 11px;
    font-weight: 500;
}

/* Sidebar Nav Buttons */
QPushButton.navButton, QPushButton[class="navButton"] {
    background-color: transparent;
    color: #cbd5e1;
    border: none;
    border-radius: 6px;
    padding: 10px 16px;
    text-align: left;
    font-size: 13px;
    font-weight: 600;
    margin: 2px 8px;
}

QPushButton.navButton:hover, QPushButton[class="navButton"]:hover {
    background-color: #312e81;
    color: #ffffff;
}

QPushButton.navButton:checked, QPushButton[class="navButton"]:checked {
    background-color: #4f46e5;
    color: #ffffff;
    font-weight: 700;
}

/* Top Header Bar */
#topHeader {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e7ff;
    padding: 8px 24px;
    min-height: 50px;
}

#headerTitle {
    font-size: 18px;
    font-weight: 700;
    color: #1e1b4b;
}

#userBadge {
    background-color: #ede9fe;
    color: #4338ca;
    padding: 6px 14px;
    border-radius: 16px;
    font-weight: 700;
    font-size: 12px;
    border: 1px solid #ddd6fe;
}

/* Dashboard Summary Cards */
QFrame.metricCard, QFrame[class="metricCard"] {
    background-color: #ffffff;
    border: 1px solid #e0e7ff;
    border-radius: 10px;
    padding: 18px;
}

QFrame.metricCard:hover, QFrame[class="metricCard"]:hover {
    border-color: #a5b4fc;
}

QLabel.metricValue {
    font-size: 26px;
    font-weight: 700;
    color: #1e1b4b;
    background: transparent;
}

QLabel.metricTitle {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    background: transparent;
}

QLabel.metricIcon {
    font-size: 20px;
    background: transparent;
}

/* Base QPushButton & Action Button Styles with High-Contrast Typography */
QPushButton {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background-color: #ffffff;
    color: #1e1b4b;
    border: 1.5px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 34px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton:hover {
    background-color: #f8fafc;
    border-color: #94a3b8;
}

QPushButton:pressed {
    background-color: #e2e8f0;
}

QPushButton.primaryButton, QPushButton[class="primaryButton"] {
    background-color: #4f46e5;
    color: #ffffff;
    border: 1px solid #4338ca;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 34px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton.primaryButton:hover, QPushButton[class="primaryButton"]:hover {
    background-color: #4338ca;
}

QPushButton.primaryButton:pressed, QPushButton[class="primaryButton"]:pressed {
    background-color: #3730a3;
}

QPushButton.secondaryButton, QPushButton[class="secondaryButton"] {
    background-color: #ffffff;
    color: #312e81;
    border: 1.5px solid #c7d2fe;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 34px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton.secondaryButton:hover, QPushButton[class="secondaryButton"]:hover {
    background-color: #eef2ff;
    border-color: #818cf8;
    color: #1e1b4b;
}

QPushButton.secondaryButton:pressed, QPushButton[class="secondaryButton"]:pressed {
    background-color: #e0e7ff;
}

QPushButton.successButton, QPushButton[class="successButton"] {
    background-color: #059669;
    color: #ffffff;
    border: 1px solid #047857;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 34px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton.successButton:hover, QPushButton[class="successButton"]:hover {
    background-color: #047857;
}

QPushButton.dangerButton, QPushButton[class="dangerButton"] {
    background-color: #e11d48;
    color: #ffffff;
    border: 1px solid #be123c;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 34px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton.dangerButton:hover, QPushButton[class="dangerButton"]:hover {
    background-color: #be123c;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
    min-height: 34px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 700;
}

/* Input Fields */
QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 6px;
    padding: 7px 10px;
    color: #1e1b4b;
    font-size: 13px;
    selection-background-color: #4f46e5;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus {
    border: 1.5px solid #4f46e5;
    background-color: #ffffff;
}

/* Tables */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e0e7ff;
    border-radius: 8px;
    gridline-color: #f1f5f9;
    selection-background-color: #ede9fe;
    selection-color: #4338ca;
    font-size: 13px;
}

QHeaderView::section {
    background-color: #f8fafc;
    color: #334155;
    font-weight: 700;
    font-size: 12px;
    padding: 8px 12px;
    border: none;
    border-bottom: 2px solid #cbd5e1;
    text-align: left;
}

QTableWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #f1f5f9;
    color: #1e1b4b;
}

/* Dialogs */
QDialog {
    background-color: #ffffff;
}

/* Tab Widgets */
QTabWidget::pane {
    border: 1px solid #e0e7ff;
    background-color: #ffffff;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: #f1f5f9;
    color: #334155;
    padding: 9px 18px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 4px;
    font-weight: 700;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #4f46e5;
    border-top: 3px solid #4f46e5;
}
