/* ===================================================================
 * College Bus Management System - Champagne Gold & Warm Ivory Theme
 * (Ultra-Clean, Bright, Prestigious University Light Gold Look - No Black)
 * =================================================================== */

/* Global Settings */
QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
    color: #44403c;
    background-color: #fcfbf8;
}

/* Sidebar Styling */
#sidebar {
    background-color: #fbf8f1;
    border-right: 1.5px solid #e8decb;
    min-width: 230px;
    max-width: 230px;
}

#sidebarHeader {
    background-color: #f3ecd8;
    padding: 16px;
    border-bottom: 2px solid #d97706;
}

#appTitle {
    color: #92400e;
    font-size: 16px;
    font-weight: 700;
}

#appSubtitle {
    color: #78716c;
    font-size: 11px;
    font-weight: 600;
}

/* Sidebar Nav Buttons */
QPushButton.navButton, QPushButton[class="navButton"] {
    background-color: transparent;
    color: #44403c;
    border: none;
    border-radius: 6px;
    padding: 10px 16px;
    text-align: left;
    font-size: 13px;
    font-weight: 600;
    margin: 2px 8px;
}

QPushButton.navButton:hover, QPushButton[class="navButton"]:hover {
    background-color: #ebe2ce;
    color: #78350f;
}

QPushButton.navButton:checked, QPushButton[class="navButton"]:checked {
    background-color: #d97706;
    color: #ffffff;
    font-weight: 700;
}

/* Top Header Bar */
#topHeader {
    background-color: #ffffff;
    border-bottom: 2px solid #d97706;
    padding: 8px 24px;
    min-height: 50px;
}

#headerTitle {
    font-size: 18px;
    font-weight: 700;
    color: #78350f;
}

#userBadge {
    background-color: #fef3c7;
    color: #92400e;
    padding: 6px 14px;
    border-radius: 16px;
    font-weight: 700;
    font-size: 12px;
    border: 1px solid #fde68a;
}

/* Dashboard Summary Cards */
QFrame.metricCard, QFrame[class="metricCard"] {
    background-color: #ffffff;
    border: 1.5px solid #fde68a;
    border-left: 5px solid #d97706;
    border-radius: 10px;
    padding: 18px;
}

QFrame.metricCard:hover, QFrame[class="metricCard"]:hover {
    border-color: #d97706;
    background-color: #fffdf8;
}

QLabel.metricValue {
    font-size: 26px;
    font-weight: 700;
    color: #78350f;
    background: transparent;
}

QLabel.metricTitle {
    font-size: 12px;
    font-weight: 600;
    color: #78716c;
    text-transform: uppercase;
    background: transparent;
}

QLabel.metricIcon {
    font-size: 20px;
    background: transparent;
}

/* Base QPushButton & Action Button Styles with High-Contrast Typography */
QPushButton {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background-color: #ffffff;
    color: #78350f;
    border: 1.5px solid #e8decb;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 34px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton:hover {
    background-color: #fffbeb;
    border-color: #d97706;
    color: #78350f;
}

QPushButton:pressed {
    background-color: #fef3c7;
}

QPushButton.primaryButton, QPushButton[class="primaryButton"] {
    background-color: #d97706;
    color: #ffffff;
    border: 1px solid #b45309;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 34px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton.primaryButton:hover, QPushButton[class="primaryButton"]:hover {
    background-color: #b45309;
}

QPushButton.primaryButton:pressed, QPushButton[class="primaryButton"]:pressed {
    background-color: #92400e;
}

QPushButton.secondaryButton, QPushButton[class="secondaryButton"] {
    background-color: #ffffff;
    color: #78350f;
    border: 1.5px solid #d97706;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 34px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton.secondaryButton:hover, QPushButton[class="secondaryButton"]:hover {
    background-color: #fef3c7;
    border-color: #b45309;
    color: #451a03;
}

QPushButton.secondaryButton:pressed, QPushButton[class="secondaryButton"]:pressed {
    background-color: #fde68a;
}

QPushButton.successButton, QPushButton[class="successButton"] {
    background-color: #059669;
    color: #ffffff;
    border: 1px solid #047857;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 34px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton.successButton:hover, QPushButton[class="successButton"]:hover {
    background-color: #047857;
}

QPushButton.dangerButton, QPushButton[class="dangerButton"] {
    background-color: #e11d48;
    color: #ffffff;
    border: 1px solid #be123c;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 34px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton.dangerButton:hover, QPushButton[class="dangerButton"]:hover {
    background-color: #be123c;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
    min-height: 34px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 700;
}

/* Input Fields */
QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1.5px solid #e8decb;
    border-radius: 6px;
    padding: 7px 10px;
    color: #44403c;
    font-size: 13px;
    selection-background-color: #d97706;
    selection-color: #ffffff;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus {
    border: 1.5px solid #d97706;
    background-color: #ffffff;
}

/* Tables */
QTableWidget {
    background-color: #ffffff;
    border: 1.5px solid #e8decb;
    border-radius: 8px;
    gridline-color: #f7f3ea;
    selection-background-color: #fef3c7;
    selection-color: #78350f;
    font-size: 13px;
}

QHeaderView::section {
    background-color: #fef9ee;
    color: #78350f;
    font-weight: 700;
    font-size: 12px;
    padding: 8px 12px;
    border: none;
    border-bottom: 2px solid #d97706;
    text-align: left;
}

QTableWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #f7f3ea;
    color: #44403c;
}

/* Dialogs */
QDialog {
    background-color: #ffffff;
}

/* Tab Widgets */
QTabWidget::pane {
    border: 1.5px solid #e8decb;
    background-color: #ffffff;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: #fbf8f1;
    color: #57534e;
    padding: 9px 18px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 4px;
    font-weight: 700;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #92400e;
    border-top: 3px solid #d97706;
}
