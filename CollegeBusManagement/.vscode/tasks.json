{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build College Bus Management",
            "type": "shell",
            "command": "export CMAKE_PREFIX_PATH=\"$(brew --prefix qt@6 2>/dev/null || brew --prefix qt 2>/dev/null || echo '/opt/homebrew/opt/qt@6'):$CMAKE_PREFIX_PATH\" && cmake -B build -S . && cmake --build build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run Application (Terminal)",
            "type": "shell",
            "command": "./build/CollegeBusManagement",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build College Bus Management",
            "problemMatcher": []
        }
    ]
}
